# Public domain Traefik will route to this app (e.g. amico.example.com)
APP_DOMAIN=

# Name of the external Docker network Traefik is running on
TRAEFIK_NETWORK=traefik

# Name of the cert resolver configured in your Traefik instance
TRAEFIK_CERTRESOLVER=le

# Hugging Face token for speaker diarization (optional)
HF_TOKEN=

# --- Access control -------------------------------------------------------
# AmicoScript refuses requests from outside the host machine until a password
# is set. Set one here, or from the app's Security panel on the host itself.
# Required for any deployment reachable from a network.
AMICOSCRIPT_PASSWORD=

# auto (default) — loopback is trusted, the network needs a session
# always     — every request needs a session, including from this machine
# off        — no authentication at all (only when something else guards it)
AMICOSCRIPT_AUTH=auto

# Token for headless clients (TUI, meeting watcher) when AMICOSCRIPT_AUTH=always.
# Leave empty to use the one the app generates when you set a password.
AMICOSCRIPT_API_TOKEN=

# --- LLM ------------------------------------------------------------------
# Host alias a container uses to reach services on your machine. The compose
# file maps host.docker.internal already; override only if your runtime uses a
# different name.
AMICOSCRIPT_DOCKER_HOST=host.docker.internal

# Force container detection on or off. Auto-detected from /.dockerenv and
# cgroups; set this only if that guesses wrong.
AMICOSCRIPT_IN_CONTAINER=
